# ═══════════════════════════════════════════════════════════════════════════
# The $100 Guy Courses — environment
#
# Copy to .env and fill in. Everything marked REQUIRED is needed before the
# site takes real money. Generate secrets with:  openssl rand -base64 32
# ═══════════════════════════════════════════════════════════════════════════

# ── App ─────────────────────────────────────────────────────────────────────
# The public origin. Must be the real domain in production, or the canonical
# URLs, sitemap, Open Graph tags and payment redirects all point elsewhere.
NEXT_PUBLIC_APP_URL="https://georgekasonsocourses.vercel.app"

# ── Database ────────────────────────────────────────────────────────────────
# Local dev: a SQLite file. Production on Vercel: a Turso/libSQL remote URL —
# Vercel has no persistent filesystem, so `file:` will not survive a deploy.
#   local      file:./local.db
#   production libsql://<name>.turso.io
#
# REQUIRED in production.
DATABASE_URL="file:./local.db"

# Only needed for a remote (Turso) database. Local SQLite ignores it.
DATABASE_AUTH_TOKEN=""

# ── Auth ────────────────────────────────────────────────────────────────────
# REQUIRED. Sign the session cookie.  openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"
AUTH_TRUST_HOST="true"

# Optional: Google sign-in through Auth.js's own OAuth client, bypassing
# Firebase. Nothing in the app uses this — the Firebase provider below is what
# the "Continue with Google" button calls. Left here so the option stays
# available, but prefer the Firebase route: one identity provider across every
# brand instead of a separate OAuth client per site.
# If you do use it, the callback must be
# https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Admin account ───────────────────────────────────────────────────────────
# The seed creates this account with role "admin", which is what unlocks
# /admin. Set the password BEFORE running the seed, then re-seed.
# To change the password on an existing database:
#   npx tsx db/reset-admin-password.ts
ADMIN_EMAIL="admin@learn2earn.online"
ADMIN_PASSWORD="ChangeMe123!"

# ── Payments: Flutterwave ───────────────────────────────────────────────────
# https://dashboard.flutterwave.com → Settings → API Keys
#
# FLW_PUBLIC_KEY   — your public key (kept for the client integration; the
#                    hosted checkout link does not need it yet)
# FLW_SECRET_KEY   — REQUIRED. Server only. Creates the payment.
# FLW_SECRET_HASH  — REQUIRED. Server only. Verifies the webhook signature.
#
# Leave FLW_SECRET_KEY blank and the checkout falls back to "manual
# approval": the order is recorded and an admin marks it paid in /admin.
FLW_PUBLIC_KEY=""
FLW_SECRET_KEY=""
FLW_SECRET_HASH=""

# REQUIRED. Where Flutterwave delivers its webhook — paste this exact URL into
# the dashboard (Settings → Webhook URLs). If it points anywhere else, the
# app never hears about the payment and the student is never unlocked.
FLW_WEBHOOK_URL="https://georgekasonsocourses.vercel.app/api/flutterwave/webhook"

# ── Google sign-in, brokered by Firebase ────────────────────────────────────
# Firebase proves who the student is; this app's own database stays the source
# of truth for courses, orders and enrolments. The browser signs in with
# Firebase and gets an ID token, which NextAuth verifies with the Admin SDK
# before any session is created.
#
# The `georgethe100guy` project is the $100 Guy brand project. Web config comes
# from Firebase Console -> Project settings -> General -> Your apps. All three
# of the NEXT_PUBLIC_ values below are required or the button is not rendered.
#
# REQUIRED in production. Without them Google sign-in is simply absent —
# email and password still works.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="georgethe100guy.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="georgethe100guy"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="georgethe100guy.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""

# Server only. Firebase Console -> Project settings -> Service accounts ->
# Generate new private key. Paste it as ONE line with the line breaks written
# as the two characters 
 — a .env value cannot contain a real newline, and
# lib/firebase-admin.ts unescapes it on load.
FIREBASE_ADMIN_PROJECT_ID="georgethe100guy"
FIREBASE_ADMIN_CLIENT_EMAIL=""
FIREBASE_ADMIN_PRIVATE_KEY=""

# ── Mail (optional) ─
# No provider is wired yet: the contact form writes to the server log and
# there is no password reset. Pick one and it is a small change in
# app/api/contact/route.ts.
RESEND_API_KEY=""
MAIL_FROM="George J. Kasonso <hello@georgekasonso.com>"
